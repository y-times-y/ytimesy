{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ytimesy-pr-repair-development",
  "main": "src/workflows/pr-repair.ts",
  "account_id": "f45021db74a97feaafae2e3e131d4d82",
  "compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": true,
  "vars": { "REPAIR_EXECUTOR_URL": "" },
  "secrets": { "required": ["GITHUB_PR_REPAIR_WEBHOOK_SECRET", "MODEL_WORKFLOW_SECRET"] },
  "workflows": [{ "binding": "PR_REPAIRS", "name": "ytimesy-pr-repairs-development", "class_name": "PrRepairWorkflow" }],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
