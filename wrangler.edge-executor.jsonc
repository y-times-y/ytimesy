{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ytimesy-edge-executor-development",
  "main": ".ytimesy/edge-executor.mjs",
  "build": { "command": "node --import tsx scripts/build-edge-executor.ts" },
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "durable_object_io_tasks_do_not_prevent_eviction"],
  "vpc_networks": [{ "binding": "CODEX_EGRESS", "network_id": "cf1:network", "remote": true }],
  "durable_objects": {
    "bindings": [
      { "name": "MODEL_CONVERSATIONS", "class_name": "ModelConversation" },
      { "name": "BACKGROUND_JOBS", "class_name": "BackgroundJobRunner" },
      { "name": "PROJECT_ENVIRONMENTS", "class_name": "ProjectEnvironment" },
      { "name": "USER_HUBS", "class_name": "UserHub" },
      { "name": "Y_SQUARED_CREWS", "class_name": "YSquaredCrew" }
    ],
    // A new version reaches a busy Durable Object only once it goes idle, up
    // to 15 minutes later (one chat step's budget), so a deploy rarely
    // interrupts a running step; one it does interrupt resumes from its receipt.
    "code_update_strategy": { "mode": "deferred", "max_delay": 900 }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ModelConversation"] },
    { "tag": "v2", "new_sqlite_classes": ["BackgroundJobRunner"] },
    { "tag": "v3", "new_sqlite_classes": ["ProjectEnvironment"] },
    // Each user's push hub (UserHub, src/server/edge/user-hub.ts).
    { "tag": "v4", "new_sqlite_classes": ["UserHub"] },
    // Each Y project's crew status and Y² wakes (src/server/edge/y-squared-crew.ts).
    { "tag": "v5", "new_sqlite_classes": ["YSquaredCrew"] }
  ],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000001", "localConnectionString": "postgres://test:test@127.0.0.1:1/test" }],
  "secrets": { "required": [] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "triggers": { "crons": ["* * * * *"] },
  // Auth email (verification, password reset) without an API token.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ytimesy.com"] }],
  // Cross-chat memory: one private Git repo per user, and line embeddings for recall.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ytimesy-memory-development" }],
  "ai": { "binding": "AI" },
  "workers_dev": true,
  "env": {
    // Production (not deployed yet). Bindings do not inherit, so each is restated.
    // workers_dev is off under the launch gate. VM guests reach the Git proxy and
    // realtime endpoints over the public URL on development; production needs a
    // route for them (behind Access with a service token, or a dedicated hostname)
    // before chats can push or stream. YTIMESY_ENVIRONMENT=production is set by the
    // deploy script like the other flags: a vars block here changes the generated
    // ProcessEnv type and breaks the executor typecheck.
    "production": {
      "name": "ytimesy-edge-executor-production",
      "vpc_networks": [{ "binding": "CODEX_EGRESS", "network_id": "cf1:network", "remote": true }],
      "durable_objects": {
        "bindings": [
          { "name": "MODEL_CONVERSATIONS", "class_name": "ModelConversation" },
          { "name": "BACKGROUND_JOBS", "class_name": "BackgroundJobRunner" },
          { "name": "PROJECT_ENVIRONMENTS", "class_name": "ProjectEnvironment" },
          { "name": "USER_HUBS", "class_name": "UserHub" },
          { "name": "Y_SQUARED_CREWS", "class_name": "YSquaredCrew" }
        ],
        "code_update_strategy": { "mode": "deferred", "max_delay": 900 }
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000001" }],
      "secrets": { "required": [] },
      "triggers": { "crons": ["* * * * *"] },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ytimesy.com"] }],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ytimesy-memory-production" }],
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "edge.ytimesy.com", "custom_domain": true }],
      "workers_dev": false
    }
  }
}
