{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ytimesy-edge-executor-development",
  "main": ".ytimesy/edge-executor.mjs",
  "build": { "command": "node --import tsx scripts/build-edge-executor.ts" },
  "account_id": "f45021db74a97feaafae2e3e131d4d82",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "vpc_networks": [{ "binding": "CODEX_EGRESS", "network_id": "cf1:network", "remote": true }],
  "durable_objects": {
    "bindings": [
      { "name": "MODEL_CONVERSATIONS", "class_name": "ModelConversation" },
      { "name": "BACKGROUND_JOBS", "class_name": "BackgroundJobRunner" },
      { "name": "PROJECT_ENVIRONMENTS", "class_name": "ProjectEnvironment" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ModelConversation"] },
    { "tag": "v2", "new_sqlite_classes": ["BackgroundJobRunner"] },
    { "tag": "v3", "new_sqlite_classes": ["ProjectEnvironment"] }
  ],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9403f3ee7ca24e16a43f903d10745dfb", "localConnectionString": "postgres://test:test@127.0.0.1:1/test" }],
  "secrets": { "required": [] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  "env": {
    // Production (not deployed yet). Bindings do not inherit, so each is restated.
    // workers_dev is off under the launch gate. VM guests reach the Git proxy and
    // realtime endpoints over the public URL on development; production needs a
    // route for them (behind Access with a service token, or a dedicated hostname)
    // before chats can push or stream.
    "production": {
      "name": "ytimesy-edge-executor-production",
      "vpc_networks": [{ "binding": "CODEX_EGRESS", "network_id": "cf1:network", "remote": true }],
      "durable_objects": {
        "bindings": [
          { "name": "MODEL_CONVERSATIONS", "class_name": "ModelConversation" },
          { "name": "BACKGROUND_JOBS", "class_name": "BackgroundJobRunner" },
          { "name": "PROJECT_ENVIRONMENTS", "class_name": "ProjectEnvironment" }
        ]
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "88d0840479284fa6ba4d75d4fb8a4d5f" }],
      "secrets": { "required": [] },
      "vars": { "YTIMESY_ENVIRONMENT": "production" },
      "triggers": { "crons": ["* * * * *"] },
      "workers_dev": false
    }
  }
}
