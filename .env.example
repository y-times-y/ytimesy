# Local development URL. Change both URLs to your HTTPS domain for deployment.
APP_URL=[REDACTED]
BETTER_AUTH_URL=[REDACTED]

# Generated locally in .env. Use a separate random secret for production.
BETTER_AUTH_SECRET=

# Freestyle team API key. Your free-tier account is fine for the initial proof.
FREESTYLE_API_KEY=

# Indexed lexical search is enabled when unset. Set 0 to force native Git.
# Unsupported queries/corpora and missing Python/SQLite fall back to Git.
# YTIMESY_INDEXED_SEARCH_ENABLED=0

# 32-byte key (hex or base64) used to encrypt harness API keys at rest.
# If unset locally, ytimesy writes one to gitignored .ytimesy/secrets.key.
# YTIMESY_SECRETS_KEY=

# Supabase Session pooler URI from the dashboard. Use TLS with certificate verification.
# Local setup uses sslmode=verify-full&sslrootcert=.secrets/supabase-ca.crt.
# Download the Supabase CA from Database settings; configure its path separately per deployment.
DATABASE_URL=
# Total connections per process, shared by HTTP/auth and jobs. Budget across replicas.
DATABASE_POOL_MAX=2

# Google OAuth client for Better Auth sign-in. Redirect:
# {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth apps for plugin/MCP services whose sign-in has no dynamic client
# registration. Optional: unset, users paste a token for that service instead.
# Redirect URI for each app: {APP_URL}/api/mcp/oauth/callback
# Slack: api.slack.com/apps, user token scopes, MCP enabled; internal or Marketplace app.
MCP_OAUTH_SLACK_CLIENT_ID=
MCP_OAUTH_SLACK_CLIENT_SECRET=
# GitHub: a dedicated OAuth App (github.com/settings/developers), not the sign-in app.
MCP_OAUTH_GITHUB_CLIENT_ID=
MCP_OAUTH_GITHUB_CLIENT_SECRET=

# Verification and password-reset email via Cloudflare Email Service (REST API).
# Set all three on the web Worker and the edge executor (it retries from cron).
# The From domain must be onboarded to Email Sending; the token needs
# "Email Sending: Edit". Unset: email sign-up and "Forgot password" are hidden.
AUTH_EMAIL_FROM=
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# GitHub OAuth App: Better Auth sign-in only.
# GitHub App: separate repository access; generated by scripts/setup-github-app.mjs.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=[REDACTED]
# PEM used only by the server-side GitHub broker, never sent to guests.
# GITHUB_PRIVATE_KEY=

# Generated locally in .env. Use this value if configuring the GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Optional private Freestyle snapshot with CLIs and package caches, no user
# secrets. Used when the signed-in user has no Codex auth snapshot yet.
# If unset, prepare reads product_setting.tools_snapshot_id, then gitignored
# .ytimesy/tools-snapshot.json.
# YTIMESY_TOOLS_SNAPSHOT_ID=

# Do not paste Codex or Claude subscription credentials here.
# Agent access will use its own sign-in flow.

GITHUB_APP_CLIENT_ID=

GITHUB_APP_CLIENT_SECRET=

# Server-only private encrypted checkpoints. Never expose these to agents.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=

# Public write-only token; omit to disable product analytics.
VITE_POSTHOG_PROJECT_TOKEN=
# Same public write-only project token, configured separately for the worker.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Server-only delivery relay. Apply the conversation-delivery migration first.
# Leave both unset for local PostgreSQL streaming; never expose this secret to the browser.
YTIMESY_REALTIME_URL=
YTIMESY_REALTIME_SECRET=
YTIMESY_MODEL_CONCURRENCY=4
YTIMESY_USER_TURN_CONCURRENCY=32
# Shared ceiling across all worker replicas; configure identically on every replica.
YTIMESY_FLEET_TURN_CONCURRENCY=256
# Children per parent, independent of how many worker replicas exist.
YTIMESY_TASK_CHILD_CONCURRENCY=8
# Infrastructure compute admission. Apply both infrastructure migrations first.
# Integer micro-USD: 1,000,000 = $1. Exact user IDs, never emails, grant admin access.
# 66120 = 30 resource-weighted minutes on the standard 2-vCPU / 4-GiB VM.
YTIMESY_INFRASTRUCTURE_ADMISSION=false
# Pause a turn's VM between tool calls while the model thinks (docs/workspace-retention.md).
YTIMESY_PAUSE_VM_WHILE_THINKING=false
YTIMESY_USER_MONTHLY_MICRO_USD=
YTIMESY_FLEET_MONTHLY_MICRO_USD=
YTIMESY_FLEET_LIFETIME_MICRO_USD=
YTIMESY_ADMIN_USER_IDS=
# Private full-state recovery. Apply the workspace-retention migration first.
# Only machines created after this fixed ISO timestamp are enrolled; older machines stay protected.
YTIMESY_WORKSPACE_RETENTION=false
YTIMESY_RETENTION_ENROLL_AFTER=
# Cloudflare edge execution. `pnpm dev` sets these for development; leave them empty only
# for the isolated local harness runner (src/server/jobs/worker.ts).
YTIMESY_MODEL_WORKFLOW_URL=
# Optional override. Otherwise the server derives a purpose-specific signing key.
YTIMESY_MODEL_WORKFLOW_SECRET=
YTIMESY_GIT_PROXY_URL=
# Optional overrides; defaults are purpose-specific derivatives of BETTER_AUTH_SECRET.
YTIMESY_GIT_PROXY_SECRET=
YTIMESY_ENVIRONMENT_WORKFLOW_URL=
YTIMESY_ENVIRONMENT_WORKFLOW_SECRET=
# Inline CA for direct request-scoped database diagnostics. Hyperdrive manages its own verified TLS.
DATABASE_SSL_CA=
YTIMESY_MODEL_EXECUTION_TARGET=node
# Cloudflare background admission (edge executor origin).
YTIMESY_BACKGROUND_WORKFLOW_URL=
YTIMESY_BACKGROUND_WORKFLOW_SECRET=
# Cloudflare-only switches; scripts/deploy-edge-development.ts sets them on the Worker.
BACKGROUND_EXECUTION_ENABLED=0
YTIMESY_BACKGROUND_CRON_ENABLED=0
# Optional subscription-only egress relay hosted by the trusted Node web backend.
# Never point this at a project VM or another Cloudflare Worker. No automatic fallback.
# YTIMESY_CODEX_RELAY_URL=https://your-backend/api/internal/codex-transport
# YTIMESY_CODEX_RELAY_SECRET=matching-random-server-to-server-key-at-least-32-characters
# Cloudflare compute budget (docs/cloudflare-budget.md). Per user, per UTC month; defaults fit 100 users.
# YTIMESY_CF_BUDGET_DO_GB_SECONDS=4000
# YTIMESY_CF_BUDGET_DO_REQUESTS=10000
# YTIMESY_CF_BUDGET_WORKER_REQUESTS=100000
# YTIMESY_CF_BUDGET_DEGRADE_PERCENT=70
# OFF by default: empty or unset = nobody is metered or held (no usage_day writes, no UserHub calls, no budget read at admission).
# Read by the edge executor. Two ways to enable it: named users (YTIMESY_CF_BUDGET_USERS=userid1,userid2) or everyone (YTIMESY_CF_BUDGET_USERS=*).
# YTIMESY_CF_BUDGET_USERS=
# Operator kill-switch, independent of YTIMESY_CF_BUDGET_USERS (applies to EVERY user when set explicitly): off (default) | degrade (all new turns degraded) | pause (new turns stay queued).
# YTIMESY_CF_BUDGET_GLOBAL=off
