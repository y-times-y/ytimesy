# Required for isolated Freestyle workspace proofs and later VM provisioning.
FREESTYLE_API_KEY=

# 32-byte key (hex or base64) used to encrypt harness API keys at rest.
# If unset locally, ytimesy writes one to gitignored .ytimesy/secrets.key.
# YTIMESY_SECRETS_KEY=

# GitHub App used to list repositories the installation can access.
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=

# Better Auth and tenant-scoped records are not implemented yet.
# DATABASE_URL=
