{
	"name": "ytimesy-infra",
	"private": true,
	"type": "module",
	"description": "Infrastructure as code (Alchemy). Its own package with its own lockfile and two pnpm patches, kept apart from the app (both are on Effect 4). Run only through scripts/infra.ts.",
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"test": "node --test src/*.test.ts"
	},
	"dependencies": {
		"@alchemy.run/aws": "2.0.0-beta.87",
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "4.1.5",
		"@effect/platform-node": "4.1.5",
		"@distilled.cloud/aws": "1.0.0-rc.20"
	},
	"devDependencies": {
		"@types/node": "22.15.0",
		"typescript": "5.9.3"
	},
	"pnpm": {
		"patchedDependencies": {
			"@alchemy.run/aws@2.0.0-beta.87": "patches/@alchemy.run__aws@2.0.0-beta.87.patch",
			"@alchemy.run/cloudflare@2.0.0-beta.87": "patches/@alchemy.run__cloudflare@2.0.0-beta.87.patch"
		}
	}
}
