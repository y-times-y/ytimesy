{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The web app (TanStack Start). Built with YTIMESY_TARGET=cloudflare; see vite.config.ts.
  "name": "ytimesy-web-development",
  "main": "./src/server.ts",
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000001" }],
  "vpc_networks": [{ "binding": "CODEX_EGRESS", "network_id": "cf1:network", "remote": true }],
  "services": [{ "binding": "EXECUTOR", "service": "ytimesy-edge-executor-development", "remote": true }],
  "vars": { "YTIMESY_DATABASE_VIA_HYPERDRIVE": "1" },
  "observability": { "enabled": true },
  // Not public: no routes, no workers.dev URL and no preview URLs until launch.
  // Auth email (verification, password reset) without an API token.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ytimesy.com"] }],
  // The Memory tab reads, and Clear memory deletes, the user's memory repo.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ytimesy-memory-development" }],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    // Production (not deployed yet). Reachable only through a route behind
    // Cloudflare Access until launch; bindings are restated because they do not inherit.
    "production": {
      "name": "ytimesy-web-production",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000001" }],
      "vpc_networks": [{ "binding": "CODEX_EGRESS", "network_id": "cf1:network", "remote": true }],
      "services": [{ "binding": "EXECUTOR", "service": "ytimesy-edge-executor-production", "remote": true }],
      "vars": { "YTIMESY_DATABASE_VIA_HYPERDRIVE": "1", "YTIMESY_ENVIRONMENT": "production" },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ytimesy.com"] }],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ytimesy-memory-production" }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
