{
	"name": "ytimesy",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx scripts/development-server.ts",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "pnpm generate-routes && tsc --noEmit && pnpm typecheck:workflows && pnpm typecheck:edge-executor",
		"typecheck:workflows": "wrangler types --config wrangler.pr-repair.jsonc --env-interface PrRepairEnvironment --strict-vars false .ytimesy/pr-repair-runtime.d.ts && tsc --noEmit --project tsconfig.workflows.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"cloud:proof": "node --env-file=.env --import tsx scripts/cloud-proof/freestyle.ts",
		"test": "vitest run",
		"harness:regression": "vitest run src/server/services/automatic-repository-context.test.ts src/server/services/harness-lifecycle-hooks.test.ts src/server/services/conversation-code-checkpoint.test.ts src/server/adapters/conversation-recovery.test.ts src/server/services/api-agent-runtime.test.ts src/server/jobs/api-turn.test.ts src/domain/harness-regression-gate.test.ts tests/harness-evaluation-grader.test.ts tests/harness-evaluation-campaign.test.ts src/server/services/api-command-scope.test.ts --maxWorkers=2 --reporter=default --reporter=junit --outputFile.junit=.ytimesy/harness-regression.xml",
		"build:edge-executor": "wrangler types --config wrangler.edge-executor.jsonc --env-interface EdgeExecutorEnvironment .ytimesy/edge-executor-runtime.d.ts && node --import tsx scripts/build-edge-executor.ts",
		"typecheck:edge-executor": "pnpm build:edge-executor && tsc --noEmit --project tsconfig.edge-executor.json",
		"prove:workspace": "tsx scripts/prove-workspace.ts",
		"prove:codex-login": "tsx scripts/codex-login.ts",
		"prove:codex-login:status": "tsx scripts/codex-login-status.ts",
		"prove:codex-login:resume": "tsx scripts/codex-login-resume.ts",
		"prove:codex-login:snapshot": "tsx scripts/codex-login-snapshot.ts",
		"prove:codex-login:cleanup": "tsx scripts/codex-login-cleanup.ts",
		"db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.65",
		"@ai-sdk/deepseek": "3.0.58",
		"@ai-sdk/google": "4.0.82",
		"@ai-sdk/mcp": "2.0.60",
		"@ai-sdk/openai": "4.0.78",
		"@ai-sdk/openai-compatible": "3.0.57",
		"@ai-sdk/provider-utils": "5.0.49",
		"@base-ui/react": "1.8.0",
		"@better-auth-ui/core": "1.7.23",
		"@better-auth-ui/react": "1.7.23",
		"@codemirror/language": "6.12.4",
		"@codemirror/language-data": "6.5.2",
		"@codemirror/theme-one-dark": "6.1.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/catppuccin": "^1.2.17",
		"@iconify-json/vscode-icons": "^1.2.78",
		"@iconify/react": "^6.0.2",
		"@iconify/types": "^2.0.0",
		"@novnc/novnc": "^1.7.0",
		"@octokit/app": "16.1.4",
		"@octokit/rest": "22.0.1",
		"@octokit/webhooks": "14.2.0",
		"@openai/agents-core": "0.19.0",
