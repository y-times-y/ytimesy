		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "^6.0.1",
		"esbuild": "0.28.2",
		"eventsource-parser": "3.1.1",
