{
	"name": "ytimesy",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 3000",
		"start:worker": "node --import tsx src/server/jobs/worker.ts",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "pnpm generate-routes && tsc --noEmit && pnpm typecheck:workflows",
		"typecheck:workflows": "wrangler types --config wrangler.model-workflows.jsonc --include-env false .ytimesy/model-workflow-runtime.d.ts && wrangler types --config wrangler.pr-repair.jsonc --env-interface PrRepairEnvironment --strict-vars false .ytimesy/pr-repair-runtime.d.ts && tsc --noEmit --project tsconfig.workflows.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"cloud:proof": "node --env-file=.env --import tsx scripts/cloud-proof/freestyle.ts",
		"test": "vitest run",
		"worker": "node --env-file-if-exists=.env --import tsx src/server/jobs/worker.ts",
		"worker:vm": "node --env-file-if-exists=.env --import tsx scripts/job-worker-vm.ts",
		"prove:workspace": "tsx scripts/prove-workspace.ts",
		"prove:codex-login": "tsx scripts/codex-login.ts",
		"prove:codex-login:status": "tsx scripts/codex-login-status.ts",
		"prove:codex-login:resume": "tsx scripts/codex-login-resume.ts",
		"prove:codex-login:snapshot": "tsx scripts/codex-login-snapshot.ts",
		"prove:codex-login:cleanup": "tsx scripts/codex-login-cleanup.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.65",
		"@ai-sdk/deepseek": "3.0.58",
		"@ai-sdk/google": "4.0.82",
		"@ai-sdk/openai": "4.0.78",
		"@ai-sdk/openai-compatible": "3.0.57",
		"@base-ui/react": "1.8.0",
		"@better-auth-ui/core": "1.7.23",
		"@better-auth-ui/react": "1.7.23",
		"@codemirror/language": "6.12.4",
		"@codemirror/language-data": "6.5.2",
		"@codemirror/theme-one-dark": "6.1.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/catppuccin": "^1.2.17",
		"@iconify-json/vscode-icons": "^1.2.78",
		"@iconify/react": "^6.0.2",
		"@iconify/types": "^2.0.0",
		"@novnc/novnc": "^1.7.0",
		"@octokit/app": "16.1.4",
