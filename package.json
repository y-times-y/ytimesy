		"tsx": "4.23.13",
		"typescript-language-server": "6.0.1",
		"vite": "^8.0.0",
		"vitest": "5.0.0",
		"vscode-jsonrpc": "9.0.3",
		"web-tree-sitter": "0.25.10",
		"wrangler": "4.146.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"packageManager": "pnpm@10.20.0"
}
