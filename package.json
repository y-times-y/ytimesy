		"@octokit/webhooks": "14.2.0",
		"@openai/agents-core": "0.19.0",
		"@openrouter/ai-sdk-provider": "3.1.0",
		"@rigkit/engine": "0.3.0",
		"@rigkit/provider-freestyle": "0.3.0",
