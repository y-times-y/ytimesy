{
	"name": "ytimesy",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "pnpm generate-routes && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"cloud:proof": "node --env-file=.env --import tsx scripts/cloud-proof/freestyle.ts",
		"test": "vitest run",
		"worker": "node --env-file-if-exists=.env --import tsx src/server/jobs/worker.ts",
		"prove:workspace": "tsx scripts/prove-workspace.ts",
		"prove:codex-login": "tsx scripts/codex-login.ts",
		"prove:codex-login:status": "tsx scripts/codex-login-status.ts",
		"prove:codex-login:resume": "tsx scripts/codex-login-resume.ts",
		"prove:codex-login:snapshot": "tsx scripts/codex-login-snapshot.ts",
		"prove:codex-login:cleanup": "tsx scripts/codex-login-cleanup.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@better-auth-ui/core": "1.7.23",
		"@better-auth-ui/react": "1.7.23",
		"@fontsource-variable/inter": "^5.3.0",
		"@novnc/novnc": "^1.7.0",
		"@octokit/app": "16.1.4",
		"@octokit/rest": "22.0.1",
		"@rigkit/provider-freestyle": "0.3.0",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"better-auth": "1.7.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "2.1.1",
		"cn": "^0.3.0",
		"date-fns": "4.4.0",
		"effect": "3.22.2",
		"freestyle": "0.2.13",
		"lucide-react": "1.45.0",
		"next-themes": "0.4.6",
		"octokit": "^5.0.5",
		"pg": "8.23.0",
		"pg-boss": "12.31.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.0",
		"react-day-picker": "10.0.1",
		"react-dom": "^19.2.0",
		"shadcn": "^4.21.0",
		"sonner": "2.0.8",
		"tailwind-merge": "3.5.0",
		"tw-animate-css": "^1.4.0",
		"ws": "8.21.3",
		"zod": "4.6.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@electric-sql/pglite": "0.5.8",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/pg": "8.23.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "^6.0.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.13",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "5.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"packageManager": "pnpm@10.20.0"
}
