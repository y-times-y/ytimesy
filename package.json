	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@cloudflare/workers-types": "5.20261002.1",
		"@electric-sql/pglite": "0.5.8",
		"@iconify-json/simple-icons": "1.2.97",
		"@repomix/tree-sitter-wasms": "0.1.17",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/pg": "8.23.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "^6.0.1",
		"@vscode/debugadapter-testsupport": "1.68.0",
		"esbuild": "0.28.2",
		"eventsource-parser": "3.1.1",
