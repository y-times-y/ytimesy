{
	"name": "ytimesy",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "pnpm generate-routes && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"prove:workspace": "tsx scripts/prove-workspace.ts",
		"prove:codex-login": "tsx scripts/codex-login.ts",
		"prove:codex-login:status": "tsx scripts/codex-login-status.ts",
		"prove:codex-login:resume": "tsx scripts/codex-login-resume.ts",
		"prove:codex-login:snapshot": "tsx scripts/codex-login-snapshot.ts",
		"prove:codex-login:cleanup": "tsx scripts/codex-login-cleanup.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"effect": "3.22.2",
		"freestyle": "0.2.13",
		"lucide-react": "1.45.0",
		"octokit": "^5.0.5",
		"radix-ui": "^1.6.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadcn": "^4.21.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.20.5",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "3.2.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"packageManager": "pnpm@10.20.0"
}
